<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeonHorizon" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/neon_cyan</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>

    <style name="Theme.NeonHorizon.Fullscreen" parent="Theme.NeonHorizon">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
